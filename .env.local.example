# Supabase-Projekt (Region Frankfurt, DSGVO/DACH) — noch kein echtes Projekt
# angelegt in Phase 0, siehe ARCHITECTURE.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transaction-Pooler (Supavisor, Port 6543) — für lib/db/pool.ts
# (Mehrschritt-Transaktionen: Fachwrite + Audit + Event in einer TX).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Session-Pooler (Port 5432) — für lib/queue/boss.ts (pg-boss braucht eine
# Session-gebundene Verbindung, kein Transaction-Pooling).
DATABASE_URL_SESSION=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Nicht Teil der ursprünglichen Variablen-Liste im Architekturplan, aber vom
# Code gebraucht: AES-256-Schlüssel (32 Byte, base64) für die Feldverschlüsselung
# der Gäste-Ausweis-/Passnummer (siehe modules/pms/guests/service.ts).
# Erzeugen z. B. mit: openssl rand -base64 32
# TODO: durch echtes KMS/Secret-Management ersetzen, bevor produktiv genutzt.
GUEST_DOCUMENT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
